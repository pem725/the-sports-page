# Python build artifacts
scripts/__pycache__/
analysis/.venv/
analysis/__pycache__/
analysis/*.log

# Claude Code — personal/local config and worktrees (do not commit)
.claude/settings.local.json
.claude/worktrees/

# Generated podcast audio — uploaded to Spotify, not hosted in-repo
audio/

# Source material for research — READ from these, never publish them.
# This repo is public (GitHub Pages serves thesportspage.net), so a saved
# article PDF or page source committed here is republishing someone else's
# copyrighted work. Keep the files locally, keep them out of git.
/*.pdf
/*.eml
/view-source_*.html
/sources/

# Contributed spreadsheets: the binary stays out, the content lives in corpus/
*.xlsx

# Copyright deposit ZIPs are derived from filing/copyright/deposits/ by
# scripts/build_copyright_manifest.py. The text deposits and the manifests are
# tracked -- they are the corpus record of what was filed and when. The ZIPs are
# just those same files bundled for upload, so they are rebuilt, not stored.
filing/copyright/batches/*/deposit.zip
